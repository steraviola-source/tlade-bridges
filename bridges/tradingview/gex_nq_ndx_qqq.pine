//@version=6
// Cloned from gex_es_spx_spy.pine to bring NQ feature-parity with ES (BOS,
// Session Boxes, Session AVWAP, Confluence Zones). Differences vs ES are
// confined to ticker selection, scaling for QQQ, and the NQ-specific
// weekly snapshot string.
indicator("GEX Levels + Breakout Structure + Session AVWAP — NQ/NDX/QQQ", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  INPUTS                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

groupTicker = "Ticker Settings"
tickerChoice = input.string("NQ", "Display Ticker", options=["NQ", "NDX", "QQQ"], group=groupTicker)
var float nqNdxSpread = 40.0

groupGex = "GEX Data"
string WEEKLY_DATA = input.text_area("S:112.20|L:28447,ZG,ZERO GAMMA,Zero Gamma~Key pivot where dealer gamma flips~Price magnet,0;28062,MP,MAX PAIN,Max Pain~Strike with maximum option pain~Expiry target,0;29504,EH,EM HIGH,Expected Move HIGH~1-sigma upper boundary~Statistical resistance,0;29191,EL,EM LOW,Expected Move LOW~1-sigma lower boundary~Statistical support,0;28525,VH,VOL HIGH,Vol Band HIGH~Volatility-based resistance~ZG + 25% EM,0;28369,VL,VOL LOW,Vol Band LOW~Volatility-based support~ZG - 25% EM,0;29512,CW,Call Wall,Strike: 29512~From Spot: +0.66%~Tot GEX: 42.74M~Hold: 65% | Break: 35%,42.7;29412,CW,Call Wall,Strike: 29412~From Spot: +0.31%~Tot GEX: 40.19M~Hold: 71% | Break: 29%,40.2;29612,CW,Call Wall,Strike: 29612~From Spot: +1.00%~Tot GEX: 38.97M~Hold: 64% | Break: 36%,39.0;29362,CW,Call Wall,Strike: 29362~From Spot: +0.14%~Tot GEX: 20.94M~Hold: 66% | Break: 34%,20.9;29712,CW,Call Wall,Strike: 29712~From Spot: +1.34%~Tot GEX: 18.79M~Hold: 64% | Break: 36%,18.8;29462,CW,Call Wall,Strike: 29462~From Spot: +0.49%~Tot GEX: 13.42M~Hold: 65% | Break: 35%,13.4;30012,CW,Call Wall,Strike: 30012~From Spot: +2.36%~Tot GEX: 12.24M~Hold: 61% | Break: 39%,12.2;29322,CW,Call Wall,Strike: 29322~From Spot: +0.01%~Tot GEX: 6.50M~Hold: 66% | Break: 34%,6.5;29812,CW,Call Wall,Strike: 29812~From Spot: +1.68%~Tot GEX: 5.46M~Hold: 63% | Break: 37%,5.5;29562,CW,Call Wall,Strike: 29562~From Spot: +0.83%~Tot GEX: 5.16M~Hold: 65% | Break: 35%,5.2;29472,CW,Call Wall,Strike: 29472~From Spot: +0.52%~Tot GEX: 4.45M~Hold: 57% | Break: 43%,4.5;29912,CW,Call Wall,Strike: 29912~From Spot: +2.02%~Tot GEX: 4.30M~Hold: 61% | Break: 39%,4.3;29422,CW,Call Wall,Strike: 29422~From Spot: +0.35%~Tot GEX: 2.99M~Hold: 61% | Break: 39%,3.0;29372,CW,Call Wall,Strike: 29372~From Spot: +0.18%~Tot GEX: 2.86M~Hold: 65% | Break: 35%,2.9;29662,CW,Call Wall,Strike: 29662~From Spot: +1.17%~Tot GEX: 2.75M~Hold: 64% | Break: 36%,2.7;29312,CW,Call Wall,Strike: 29312~From Spot: -0.03%~Tot GEX: 94.18M~Hold: 66% | B